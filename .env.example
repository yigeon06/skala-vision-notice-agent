# LangSmith는 필요할 때만 true로 바꾸고 실제 API 키를 입력한다.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=lsv2_pt_...
LANGCHAIN_PROJECT=notice-schedule-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# 로컬 Vision 모델
OLLAMA_VISION_MODEL=qwen3-vl:4b-instruct
OLLAMA_VISION_NUM_CTX=16384

# OCR 텍스트 구조화
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2

# 의미 검색 임베딩과 문자 기반 청킹
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_BASE_URL=http://127.0.0.1:11434
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_CHUNK_SIZE=1800
EMBEDDING_CHUNK_OVERLAP=250
SEMANTIC_SEARCH_TOP_K=3
RAG_CHUNKS_PER_NOTICE=2
